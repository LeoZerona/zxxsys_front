# 测试环境配置
# 测试环境变量，用于测试服务器部署

# 应用标题
VITE_APP_TITLE=题库管理系统-测试环境

# API 基础地址（测试环境使用完整 URL）
VITE_API_BASE_URL=http://test-api.example.com/api

# 后端服务地址（用于 Vite 代理配置，测试环境通常不需要代理）
VITE_API_TARGET=http://test-api.example.com

# 应用环境标识
VITE_APP_ENV=test

# 是否启用 Mock 数据
VITE_USE_MOCK=false

# 是否显示调试信息
VITE_DEBUG=true
